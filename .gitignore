# Generated build trees (never committed: every stage stamps into build/)
/build/

# Python caches from the host-side verification scripts
__pycache__/
*.pyc

# Vitis HLS project directories (the packaged IP goes to build/ip_repo)
**/*_prj/
**/*_hls/
ip/custom/**/vitis_hls.log
*.jou
*.log

# Scenes, captures and fixtures written by the step test benches
step*/data/

# Per-machine tool paths and licences (see config.mk)
config.local.mk
# Simulink backups made when saving an older-format model
*.slx.r20*
*.slx.autosave
