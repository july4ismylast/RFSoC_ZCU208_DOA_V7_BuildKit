# V06 Gate-2: one-channel out-of-context synthesis of Channelizer_DUT.
#
# Run through the local Makefile gate2 target.  This script consumes the
# Verilog already proved/generated by Gate 1; it does not invoke MATLAB,
# does not package IP, and does not touch any ZCU208 block design.

set script_dir [file dirname [file normalize [info script]]]
set root_dir [file normalize [file join $script_dir .. .. ..]]
source [file join $root_dir config ip_versions.tcl]

proc log_line {fh message} {
    puts $message
    puts $fh $message
    flush $fh
}

proc read_text_file {path} {
    set fh [open $path r]
    set data [read $fh]
    close $fh
    return $data
}

proc report_value {text key} {
    set prefix "${key}="
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[string first $prefix $line] == 0} {
            return [string trim [string range $line [string length $prefix] end]]
        }
    }
    error "Required key $key is missing from report text"
}

proc require_report_value {fh text key expected} {
    set actual [report_value $text $key]
    log_line $fh "GATE1_${key}=$actual"
    if {$actual ne $expected} {
        error "Gate-1 $key is '$actual', expected '$expected'"
    }
    return $actual
}

proc collect_hdl_files {dir} {
    set result {}
    foreach entry [glob -nocomplain -directory $dir *] {
        if {[file isdirectory $entry]} {
            set result [concat $result [collect_hdl_files $entry]]
        } elseif {[regexp -nocase {\.(v|sv|vhd|vhdl)$} [file extension $entry]]} {
            lappend result [file normalize $entry]
        }
    }
    return $result
}

proc parse_utilization {text label} {
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[string first "|" $line] < 0} {
            continue
        }
        set cells {}
        foreach cell [split $line "|"] {
            set cell [string trim $cell]
            if {$cell ne ""} {
                lappend cells $cell
            }
        }
        if {[llength $cells] < 4} {
            continue
        }
        # Vivado can mark a row with a footnote asterisk, for example
        # "CLB LUTs*".  Compare the cleaned first cell instead of using
        # an exact regular expression against the raw table line.
        set row_label [string trimright [lindex $cells 0] "* "]
        if {$row_label eq $label} {
            return [list [lindex $cells 1] [lindex $cells end-1] [lindex $cells end]]
        }
    }
    return {}
}

proc parse_timing_summary {text} {
    set lines [split $text "\n"]
    set count [llength $lines]
    for {set i 0} {$i < $count} {incr i} {
        if {[string first "WNS(ns)" [lindex $lines $i]] < 0} {
            continue
        }
        for {set j [expr {$i + 1}]} {$j < $count} {incr j} {
            set fields [regexp -all -inline {\S+} [string trim [lindex $lines $j]]]
            if {[llength $fields] < 8} {
                continue
            }
            set first [lindex $fields 0]
            if {[string is double -strict $first] || [string equal -nocase $first "inf"]} {
                return $fields
            }
        }
    }
    return {}
}

set top_module "Channelizer_DUT"
set output_dir [file join $root_dir build output]
set work_dir [file join $root_dir build v06_gate2_ooc]
file mkdir $output_dir
file mkdir $work_dir

set summary_file [file join $output_dir v06_gate2_ooc_synthesis.rpt]
set utilization_file [file join $output_dir v06_gate2_utilization.rpt]
set utilization_hier_file [file join $output_dir v06_gate2_utilization_hierarchical.rpt]
set timing_summary_file [file join $output_dir v06_gate2_timing_summary.rpt]
set timing_paths_file [file join $output_dir v06_gate2_timing_paths.rpt]
set clocks_file [file join $output_dir v06_gate2_clocks.rpt]
set check_timing_file [file join $output_dir v06_gate2_check_timing.rpt]
set checkpoint_file [file join $work_dir Channelizer_DUT_ooc_synth.dcp]
set gate1_report [file join $output_dir v06_gate1_hdl_generation.rpt]
set xdc_file [file join $script_dir v06_gate2_ooc.xdc]

set summary_fh [open $summary_file w]
log_line $summary_fh "# V06 Gate 2: one-channel Vivado OOC synthesis, no packaging"
log_line $summary_fh "GATE2_SCRIPT_REVISION=1"
log_line $summary_fh "TOP_MODULE=$top_module"
log_line $summary_fh "GATE1_REPORT=$gate1_report"
log_line $summary_fh "XDC_FILE=$xdc_file"
log_line $summary_fh "REPORT=$summary_file"

set gate_status "PASS"
set gate_error ""
set gate_error_info ""

set catch_rc [catch {
    doa_require_vivado_lock
    log_line $summary_fh "VIVADO_VERSION=[version -short]"
    log_line $summary_fh "PART=$::PART_PINNED"
    log_line $summary_fh "BOARD_PART_CONTEXT=$::BOARD_PART_PINNED"

    set clock_period_ns [::doa_versions::env_or WIDEBAND_CLOCK_PERIOD_NS "4.0"]
    if {![string is double -strict $clock_period_ns] || abs($clock_period_ns - 4.0) > 0.000001} {
        error "Gate-2 XDC is fixed at 4.000 ns, but WIDEBAND_CLOCK_PERIOD_NS=$clock_period_ns"
    }
    log_line $summary_fh "CLOCK_PERIOD_NS=$clock_period_ns"
    log_line $summary_fh "CLOCK_FREQUENCY_MHZ=[format %.6f [expr {1000.0 / $clock_period_ns}]]"

    set requested_jobs [::doa_versions::env_or JOBS "8"]
    if {![string is integer -strict $requested_jobs] || $requested_jobs < 1} {
        error "JOBS must be a positive integer, got '$requested_jobs'"
    }
    set jobs [expr {min($requested_jobs, 8)}]
    log_line $summary_fh "JOBS_REQUESTED=$requested_jobs"
    log_line $summary_fh "VIVADO_MAXTHREADS=$jobs"
    set_param general.maxThreads $jobs

    if {![file exists $gate1_report]} {
        error "Gate-1 report missing: $gate1_report. Run make -C ip/matlab/channelizer_hdl gate1 first."
    }
    if {![file exists $xdc_file]} {
        error "Gate-2 XDC missing: $xdc_file"
    }

    set gate1_text [read_text_file $gate1_report]
    if {[string first "V06 GATE1 HDL GENERATION RESULT=PASS" $gate1_text] < 0} {
        error "Gate-1 report does not contain a PASS result"
    }
    require_report_value $summary_fh $gate1_text "GATE1_SCRIPT_REVISION" "2-line-parser"
    require_report_value $summary_fh $gate1_text "NUM_BANDS" "1024"
    require_report_value $summary_fh $gate1_text "SSR_SAMPLES_PER_CYCLE" "8"
    require_report_value $summary_fh $gate1_text "TAPS_PER_BAND" "12"
    require_report_value $summary_fh $gate1_text "STOPBAND_DB" "100"
    require_report_value $summary_fh $gate1_text "NORMALIZE" "0"
    require_report_value $summary_fh $gate1_text "GENERATED_MODULE" $top_module
    require_report_value $summary_fh $gate1_text "EXPECTED_OBJECT_LATENCY_CYCLES" "1760"

    set gate1_verilog_count [report_value $gate1_text "GENERATED_COUNT.v"]
    log_line $summary_fh "GATE1_GENERATED_COUNT_V=$gate1_verilog_count"
    if {![string is integer -strict $gate1_verilog_count] || $gate1_verilog_count < 1} {
        error "Gate-1 report does not record a positive Verilog file count"
    }
    set gate1_output_type [report_value $gate1_text "EXPECTED_OUTPUT_TYPE"]
    log_line $summary_fh "GATE1_EXPECTED_OUTPUT_TYPE=$gate1_output_type"
    if {[string first "wordLength=26" $gate1_output_type] < 0 || [string first "fractionLength=24" $gate1_output_type] < 0} {
        error "Gate-1 output type is not signed 26/24: $gate1_output_type"
    }

    set generated_top [file normalize [report_value $gate1_text "GENERATED_TOP"]]
    if {![file exists $generated_top]} {
        set expected_top [file normalize [file join $script_dir hdl_prj hdlsrc zu48dr_channelizer_ip Channelizer_DUT.v]]
        log_line $summary_fh "GATE1_TOP_PATH_NOT_FOUND=$generated_top"
        if {![file exists $expected_top]} {
            error "Generated Channelizer_DUT.v not found at Gate-1 path or expected path $expected_top"
        }
        set generated_top $expected_top
        log_line $summary_fh "GENERATED_TOP_FALLBACK=$generated_top"
    }
    log_line $summary_fh "GENERATED_TOP=$generated_top"

    set generated_root [file dirname $generated_top]
    set all_hdl_files [lsort -unique [collect_hdl_files $generated_root]]
    if {[llength $all_hdl_files] == 0} {
        error "No HDL files found recursively under $generated_root"
    }

    set verilog_files {}
    set systemverilog_files {}
    set vhdl_files {}
    set top_matches {}
    set hdl_total_bytes 0
    foreach hdl_file $all_hdl_files {
        set hdl_total_bytes [expr {$hdl_total_bytes + [file size $hdl_file]}]
        switch -- [string tolower [file extension $hdl_file]] {
            ".v" { lappend verilog_files $hdl_file }
            ".sv" { lappend systemverilog_files $hdl_file }
            ".vhd" { lappend vhdl_files $hdl_file }
            ".vhdl" { lappend vhdl_files $hdl_file }
        }
        if {[file rootname [file tail $hdl_file]] eq $top_module} {
            lappend top_matches $hdl_file
        }
    }
    if {[llength $top_matches] != 1} {
        error "Expected exactly one $top_module HDL file under $generated_root, found [llength $top_matches]: $top_matches"
    }
    if {[file normalize [lindex $top_matches 0]] ne $generated_top} {
        error "Top file mismatch: collected [lindex $top_matches 0], Gate-1 generated $generated_top"
    }

    log_line $summary_fh "GENERATED_ROOT=$generated_root"
    log_line $summary_fh "HDL_FILE_COUNT=[llength $all_hdl_files]"
    log_line $summary_fh "VERILOG_FILE_COUNT=[llength $verilog_files]"
    log_line $summary_fh "SYSTEMVERILOG_FILE_COUNT=[llength $systemverilog_files]"
    log_line $summary_fh "VHDL_FILE_COUNT=[llength $vhdl_files]"
    log_line $summary_fh "HDL_TOTAL_BYTES=$hdl_total_bytes"

    cd $work_dir
    if {[llength $verilog_files] > 0} {
        read_verilog $verilog_files
    }
    if {[llength $systemverilog_files] > 0} {
        read_verilog -sv $systemverilog_files
    }
    if {[llength $vhdl_files] > 0} {
        read_vhdl $vhdl_files
    }
    read_xdc -mode out_of_context $xdc_file

    log_line $summary_fh "SYNTHESIS_STARTED=1"
    set synth_start_seconds [clock seconds]
    synth_design -top $top_module -part $::PART_PINNED -mode out_of_context -flatten_hierarchy rebuilt
    set synth_elapsed_seconds [expr {[clock seconds] - $synth_start_seconds}]
    log_line $summary_fh "SYNTHESIS_SECONDS=$synth_elapsed_seconds"
    log_line $summary_fh "SYNTHESIS_COMPLETED=1"

    write_checkpoint -force $checkpoint_file
    log_line $summary_fh "CHECKPOINT=$checkpoint_file"

    report_utilization -file $utilization_file
    report_utilization -hierarchical -hierarchical_depth 4 -file $utilization_hier_file
    report_timing_summary -delay_type min_max -report_unconstrained -max_paths 10 -file $timing_summary_file
    report_timing -delay_type max -max_paths 20 -nworst 1 -sort_by slack -file $timing_paths_file
    report_clocks -file $clocks_file
    check_timing -verbose -file $check_timing_file

    log_line $summary_fh "UTILIZATION_REPORT=$utilization_file"
    log_line $summary_fh "UTILIZATION_HIERARCHICAL_REPORT=$utilization_hier_file"
    log_line $summary_fh "TIMING_SUMMARY_REPORT=$timing_summary_file"
    log_line $summary_fh "TIMING_PATHS_REPORT=$timing_paths_file"
    log_line $summary_fh "CLOCKS_REPORT=$clocks_file"
    log_line $summary_fh "CHECK_TIMING_REPORT=$check_timing_file"

    set utilization_text [read_text_file $utilization_file]
    set resource_specs {
        {CLB_LUTS "CLB LUTs"}
        {CLB_REGISTERS "CLB Registers"}
        {BLOCK_RAM_TILE "Block RAM Tile"}
        {URAM "URAM"}
        {DSPS "DSPs"}
    }
    set x4_exceeds {}
    foreach resource_spec $resource_specs {
        set resource_key [lindex $resource_spec 0]
        set resource_label [lindex $resource_spec 1]
        set resource_values [parse_utilization $utilization_text $resource_label]
        if {[llength $resource_values] != 3} {
            error "Could not parse utilization row '$resource_label' from $utilization_file"
        }
        set resource_used [lindex $resource_values 0]
        set resource_available [lindex $resource_values 1]
        set resource_percent [lindex $resource_values 2]
        if {![string is double -strict $resource_used] || ![string is double -strict $resource_available]} {
            error "Non-numeric utilization for $resource_label: used=$resource_used available=$resource_available"
        }
        set resource_x4 [expr {4.0 * $resource_used}]
        set resource_x4_percent "NA"
        if {$resource_available > 0} {
            set resource_x4_percent [format %.4f [expr {100.0 * $resource_x4 / $resource_available}]]
        }
        log_line $summary_fh "UTIL_${resource_key}_USED=$resource_used"
        log_line $summary_fh "UTIL_${resource_key}_AVAILABLE=$resource_available"
        log_line $summary_fh "UTIL_${resource_key}_PERCENT=$resource_percent"
        log_line $summary_fh "X4_${resource_key}_USED=[format %.3f $resource_x4]"
        log_line $summary_fh "X4_${resource_key}_PERCENT_OF_PART=$resource_x4_percent"
        if {$resource_available > 0 && $resource_x4 > $resource_available} {
            lappend x4_exceeds $resource_key
        }
    }
    if {[llength $x4_exceeds] == 0} {
        log_line $summary_fh "X4_EXCEEDS_PART=NONE"
    } else {
        log_line $summary_fh "X4_EXCEEDS_PART=[join $x4_exceeds ,]"
        set gate_status "FAIL"
        set gate_error "Crude x4 resource extrapolation exceeds the part for: [join $x4_exceeds {, }]"
    }

    set timing_text [read_text_file $timing_summary_file]
    set timing_fields [parse_timing_summary $timing_text]
    if {[llength $timing_fields] < 8} {
        error "Could not parse Design Timing Summary from $timing_summary_file"
    }
    set wns_ns [lindex $timing_fields 0]
    set tns_ns [lindex $timing_fields 1]
    set tns_failing_endpoints [lindex $timing_fields 2]
    set tns_total_endpoints [lindex $timing_fields 3]
    set whs_ns [lindex $timing_fields 4]
    set ths_ns [lindex $timing_fields 5]
    set ths_failing_endpoints [lindex $timing_fields 6]
    set ths_total_endpoints [lindex $timing_fields 7]

    log_line $summary_fh "TIMING_WNS_NS=$wns_ns"
    log_line $summary_fh "TIMING_TNS_NS=$tns_ns"
    log_line $summary_fh "TIMING_TNS_FAILING_ENDPOINTS=$tns_failing_endpoints"
    log_line $summary_fh "TIMING_TNS_TOTAL_ENDPOINTS=$tns_total_endpoints"
    log_line $summary_fh "TIMING_WHS_NS=$whs_ns"
    log_line $summary_fh "TIMING_THS_NS=$ths_ns"
    log_line $summary_fh "TIMING_THS_FAILING_ENDPOINTS=$ths_failing_endpoints"
    log_line $summary_fh "TIMING_THS_TOTAL_ENDPOINTS=$ths_total_endpoints"

    set setup_timing_pass 1
    if {![string equal -nocase $wns_ns "inf"]} {
        if {![string is double -strict $wns_ns] || $wns_ns < 0.0} {
            set setup_timing_pass 0
        }
    }
    if {![string is double -strict $tns_ns] || abs($tns_ns) > 0.0005} {
        set setup_timing_pass 0
    }
    if {![string is integer -strict $tns_failing_endpoints] || $tns_failing_endpoints != 0} {
        set setup_timing_pass 0
    }
    if {![string is integer -strict $tns_total_endpoints] || $tns_total_endpoints <= 0} {
        set setup_timing_pass 0
    }
    log_line $summary_fh "SETUP_TIMING_PASS=$setup_timing_pass"
    if {!$setup_timing_pass} {
        set gate_status "FAIL"
        set timing_error "Setup timing failed at 4.000 ns: WNS=$wns_ns ns, TNS=$tns_ns ns, failing endpoints=$tns_failing_endpoints"
        if {$gate_error eq ""} {
            set gate_error $timing_error
        } else {
            append gate_error "; $timing_error"
        }
    }

    log_line $summary_fh "IMPLEMENTATION_PERFORMED=0"
    log_line $summary_fh "PACKAGING_PERFORMED=0"
} catch_message]

if {$catch_rc} {
    set gate_status "FAIL"
    set gate_error $catch_message
    set gate_error_info $::errorInfo
}

if {$gate_status ne "PASS"} {
    if {$gate_error eq ""} {
        set gate_error "Gate-2 failed without a specific error message"
    }
    log_line $summary_fh "GATE2_ERROR=$gate_error"
    if {$gate_error_info ne ""} {
        log_line $summary_fh "GATE2_ERROR_INFO_BEGIN=1"
        log_line $summary_fh $gate_error_info
        log_line $summary_fh "GATE2_ERROR_INFO_END=1"
    }
    log_line $summary_fh "IMPLEMENTATION_PERFORMED=0"
    log_line $summary_fh "PACKAGING_PERFORMED=0"
}

log_line $summary_fh "V06 GATE2 OOC SYNTHESIS RESULT=$gate_status"
close $summary_fh

if {$gate_status ne "PASS"} {
    error "V06 Gate-2 OOC synthesis failed: $gate_error"
}

puts "V06 Gate-2 OOC synthesis PASS: $summary_file"
